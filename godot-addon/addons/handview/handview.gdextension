[configuration]

entry_symbol = "handview_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/handview/bin/handview.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/handview/bin/handview.windows.template_release.x86_64.dll"
macos.debug.arm64 = "res://addons/handview/bin/handview.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/handview/bin/handview.macos.template_release.arm64.dylib"
